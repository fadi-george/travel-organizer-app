# Convex Backend
CONVEX_URL=https://your-deployment.convex.cloud

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key

# Google Places API (for address autocomplete and geocoding)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Weather APIs (only one required)
# Option 1: OpenWeatherMap One Call API 3.0
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key

# Option 2: Tomorrow.io
TOMORROWIO_API_KEY=your-tomorrowio-api-key
